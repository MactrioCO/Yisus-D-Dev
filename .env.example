# ── YISUS D DEV · variables de entorno ─────────────────────────
# Copia este archivo como `.env` y rellena TUS valores.
# El `.env` real NUNCA se sube a git (ya está en .gitignore).

# ── Frontend (públicas, seguras con RLS) ─────────────────────────
# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://turef.supabase.co
# Supabase → Project Settings → Data API → anon public key
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Solo para `npm run migrate` (SECRETAS, jamás al frontend) ───
# La parte "turef" de tu SUPABASE_URL
SUPABASE_PROJECT_REF=turef
# Supabase dashboard (avatar) → Account → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=sbp_...

# ── Opcional: Edge Function del bot (ver docs/OWNER_PANEL.md §6) ──
# VITE_MACTRIO_FUNCTION_URL=https://turef.supabase.co/functions/v1/mactrio-reply
